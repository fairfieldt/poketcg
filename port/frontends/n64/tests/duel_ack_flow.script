# The prequeued A was pressed and released before the first visible card.
wait 8
expect ASK~ack/card
expect_none FLOW_RETURN~draw
shot drawn_card_waits_for_fresh_a
press A
wait 8
expect FLOW_RETURN~draw~answer=0
expect ASK~ack/text
expect_none FLOW_RETURN~placement
shot placement_on_board_waits
press A
wait 6
expect FLOW_RETURN~placement~answer=0
expect ASK~card_list~PLAYER
expect_none FLOW_RETURN~forced
press A
wait 8
expect FLOW_RETURN~forced~answer=0
expect ASK~duel_menu~PLAYER
expect_none FLOW_RETURN~actions
shot actions_ignore_queued_placement_a
press A
wait 6
expect FLOW_RETURN~actions~answer=0
expect_none FLOW_RETURN~intentional-hand
press A
wait 6
expect FLOW_RETURN~intentional-hand~answer=0
expect ACK_FLOW_PASS
